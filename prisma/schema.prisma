generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String?        @unique
  image           String?
  phone           String?
  className       String?
  profileComplete Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  accounts      Account[]
  sessions      Session[]
  accesses      BatchAccess[]
  conversations Conversation[]
  messages      Message[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Batch {
  id           String    @id @default(cuid())
  title        String
  imageUrl     String?
  className    String
  medium       String
  teacherName  String    @default("Aman")

  startDate    DateTime?
  endDate      DateTime?
  syllabusDate DateTime?

  price        Int       @default(0)
  about        String    @db.Text
  customPoints Json?
  buyEnabled   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accesses      BatchAccess[]
  sections      BatchSection[]
  notifications Notification[]
  conversations Conversation[]
}

model BatchAccess {
  id        String   @id @default(cuid())
  userId    String
  batchId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([userId, batchId])
}

enum ContentKind {
  CLASS
  NOTES
  PRACTICE
}

model BatchSection {
  id        String      @id @default(cuid())
  batchId   String
  kind      ContentKind
  title     String
  sortOrder Int         @default(0)

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  items ContentItem[]
}

model ContentItem {
  id          String    @id @default(cuid())
  sectionId   String
  title       String
  url         String
  fileType    String?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())

  section BatchSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String   @id @default(cuid())
  batchId        String
  text           String?  @db.Text
  attachmentUrl  String?
  attachmentType String?
  createdAt      DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  batchId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch    Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userId, batchId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String?  @db.Text
  attachmentUrl  String?
  attachmentType String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model TutorPage {
  id        String   @id @default("main")
  content   Json
  updatedAt DateTime @updatedAt
}
